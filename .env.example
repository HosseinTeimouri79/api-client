JWT_SECRET=change-me-with-openssl-rand-hex-32
PORT=3000
COOKIE_SECURE=false        # true when served over HTTPS
TRUST_PROXY=false          # true behind a reverse proxy (nginx/traefik)
ADMIN_USERNAMES=             # comma-separated usernames that get admin panel access on start (the first registered user is admin automatically)
ALLOW_PRIVATE_TARGETS=false # true only to call internal/localhost APIs
