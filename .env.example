JWT_SECRET=change-me-with-openssl-rand-hex-32
PORT=3000
COOKIE_SECURE=false        # true when served over HTTPS
TRUST_PROXY=false          # true behind a reverse proxy (nginx/traefik)
ADMIN_USERNAMES=             # comma-separated usernames that get admin panel access on start (the first registered user is admin automatically)
ALLOW_PRIVATE_TARGETS=false # true only to call internal/localhost APIs
# SCRIPT_TIMEOUT_MS=1500  REQUEST_TIMEOUT_MS=30000  MAX_RESPONSE_BYTES=10485760  DB_PATH=./data/app.db
# Per-user request limits (Settings → Request): defaults used when none are sent, and the ceilings they are capped to (0 = no ceiling)
# MAX_REQUEST_TIMEOUT_MS=600000  MAX_RESPONSE_BYTES_LIMIT=104857600
# Local mode (requests sent by the Local Agent on each user's computer): LOCAL_AGENT=false turns it off.
# PUBLIC_URL is the address users open the app at (for the agent's install commands); otherwise taken from the request.
# LOCAL_AGENT=true  PUBLIC_URL=https://api.example.com  AGENT_INSTALLERS_DIR=./build/installers  AGENT_DEFAULT_URL=http://127.0.0.1:47823
