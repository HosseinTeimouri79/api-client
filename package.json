{
  "name": "api-client",
  "version": "1.10.0",
  "description": "A self-hostable, team-oriented API client: collections, environments, scripting, code snippets, Postman and Hoppscotch import/export.",
  "keywords": [
    "api-client",
    "http",
    "rest",
    "postman",
    "hoppscotch",
    "self-hosted",
    "collections",
    "team"
  ],
  "author": "Hossein Teimouri (https://github.com/HosseinTeimouri79)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/HosseinTeimouri79/api-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HosseinTeimouri79/api-client.git"
  },
  "bugs": {
    "url": "https://github.com/HosseinTeimouri79/api-client/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "pretest": "npm run build",
    "test": "node --test --no-warnings --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "amqplib": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "crypto-js": "^4.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "graphql": "^17.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.16.0",
    "protobufjs": "^8.8.0",
    "quickjs-emscripten": "^0.32.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "aedes": "^1.2.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.3",
    "zustand": "^5.0.15"
  }
}
